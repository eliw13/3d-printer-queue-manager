# Copy this file to .env and fill in your printer's details.
# .env is ignored by Git, so your access code never leaves your PC.

# Printer's IP on your home network (Settings > Network on the printer)
PRINTER_IP=192.168.1.50
# 8-character LAN access code (Settings > Network on the printer)
PRINTER_ACCESS_CODE=
# Serial number (Settings > Device on the printer, or in Bambu Handy)
PRINTER_SERIAL=

# Where the web app listens. 127.0.0.1 = this PC only.
# Use 0.0.0.0 to reach it from your phone on the same Wi-Fi.
APP_HOST=127.0.0.1
APP_PORT=8000

# true = fake printer data, no connection to the real printer
PRINTER_MOCK=false
